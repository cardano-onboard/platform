APP_NAME="Onboard.Ninja"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=onboard
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
# Local defaults use file and sync so no extra services are required for
# development. On a Redis-backed host use redis for cache and session; for the
# queue connection use whatever driver your host supports, for example:
#   CACHE_DRIVER=redis
#   SESSION_DRIVER=redis
#   QUEUE_CONNECTION=database   (some managed hosts set their own driver automatically)
# The withoutOverlapping and RateLimited job middleware rely on an atomic cache
# lock, so the cache store must be redis (or database) once more than one worker
# runs, otherwise the lock is not shared across workers.
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# How long a worker keeps a job reserved, in seconds. Once it passes, the job is
# handed to a second worker even if the first is still running it, so this has to
# stay longer than the longest job in the application. On SQS the same window is
# the queue's visibility timeout and is set in AWS instead.
QUEUE_RETRY_AFTER=1200
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# REDIS_CLIENT: phpredis (the PHP extension, used on Cloud) or predis (a pure-PHP
# fallback, bundled, for environments without the extension).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev uses smtp against mailpit. For production email delivery use Postmark
# (set MAIL_MAILER=postmark and POSTMARK_TOKEN below). Postmark replaces SES, which
# is not available on every managed host.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Postmark (production email). Server API token from the Postmark dashboard.
# POSTMARK_MESSAGE_STREAM_ID is optional; leave blank to use the default stream.
POSTMARK_TOKEN=
POSTMARK_MESSAGE_STREAM_ID=

# Object storage. Leave blank when self-hosting on the local disk.
#   - A plain S3 bucket: FILESYSTEM_DISK=s3 plus the credentials below.
#   - A managed host that attaches a bucket for you: it injects FILESYSTEM_DISK and
#     every AWS_* value below automatically, so do NOT set them by hand there.
#     FILESYSTEM_DISK is set to the "disk name" chosen when the bucket was created —
#     this app ships a "private" disk in config/filesystems.php to match. AWS_URL is
#     the one exception: it is shown on the bucket settings page but not injected, so
#     add it as a custom variable if a public bucket needs it.
# An s3-driver disk with no AWS_BUCKET/AWS_DEFAULT_REGION cannot be used at all; the app
# logs the missing keys and falls back to the local disk rather than erroring out.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# How long, in minutes, a browser has to finish uploading a codes file against the signed
# PUT this app issues. It has to outlast a large file on a slow connection and no longer:
# until it expires the URL is a standing permission to write to the bucket. Bulk upload
# needs a disk that can sign one, so on the local disk it is refused with an explanation
# and codes are added without a file.
SIGNED_UPLOAD_EXPIRES_MINUTES=5

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# -----------------------------------------------------------------------------
# Sanctum (stateful SPA auth)
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

# -----------------------------------------------------------------------------
# Admin seeder (DIY single-admin mode)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@onboard.ninja
ADMIN_PASSWORD=password

# -----------------------------------------------------------------------------
# Cardano / Platform
# -----------------------------------------------------------------------------
POO_PUSH_DELAY=

# Upload limits
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_CODES=10000

# Claim API rate limits (requests per minute)
CLAIM_RATE_PER_IP=60
CLAIM_RATE_PER_CAMPAIGN=120

# Claim API rate limit for a request carrying a Sanctum token with the codes:claim
# ability, applied instead of the shared IP and campaign limits above (requests per
# minute, shared across every codes:claim token one account holds)
CLAIM_RATE_PER_TOKEN=300

# Code API: rate limits (per token, requests per minute, create and status kept
# separate) and the bounds on one code-creation request's token array
CODE_API_CREATE_RATE_PER_TOKEN=60
CODE_API_STATUS_RATE_PER_TOKEN=60
CODE_API_MAX_TOKENS_PER_CODE=20
CODE_API_MAX_TOKEN_QUANTITY=1000000

# Reward minimums. Every Cardano output has to hold a minimum amount of ADA that
# rises with the number of policies, assets and the length of every asset name,
# so a code below its own minimum can never be paid. COINS_PER_UTXO_BYTE is a
# protocol parameter read from the chain; this is the fallback when that read
# fails. MIN_UTXO_HEADROOM_LOVELACE is how far above the minimum a reward has to
# sit before the form stops warning that the recipient cannot spend it.
COINS_PER_UTXO_BYTE=4310
MIN_UTXO_ADDRESS_BYTES=57
MIN_UTXO_HEADROOM_LOVELACE=1000000

# Cardano networks this deployment will accept for a campaign (comma separated).
# Leave as all three unless you want to lock an environment down: a staging or
# demo install sets preprod,preview so no real mainnet funds can pass through it.
ALLOWED_NETWORKS=preprod,preview,mainnet

# Where mainnet campaigns are created when this deployment does not accept them
# (mainnet missing from ALLOWED_NETWORKS above). Shows a short hint on the campaign
# create form's network field pointing there; leave unset and nothing is shown.
#MAINNET_APP_URL=https://example.com

# Deployment notice (all optional). A short operator-facing banner shown on the login,
# dashboard and other operator pages, never on attendee-facing pages such as /ada/now
# or a claim link. Leave APP_NOTICE unset (the default) and nothing is shown.
#APP_NOTICE="This platform is now preprod only. Create mainnet campaigns on the main app."
# "info" or "warning". Anything else falls back to "info".
#APP_NOTICE_TYPE=info
# Optional link shown after the message. The URL must be http(s) or it is dropped and
# only the message renders.
#APP_NOTICE_LINK_URL=https://example.com
#APP_NOTICE_LINK_TEXT="Go to the main app"

# Estimated chain cost of putting one claim in front of one recipient, in lovelace. A
# fact about the network rather than a price anyone sets: it funds a campaign's bucket
# and accounts for what a campaign spent, and it is never revenue. Recorded on each claim
# as the estimate it is, because claims are batched and the real fee is per transaction
# rather than per recipient.
NETWORK_FEE_LOVELACE=200000

# -----------------------------------------------------------------------------
# Transaction Backend
# Valid values: null (testing), phyrhose (direct), proxy (SaaS relay)
# Default is 'null' for safe local development — no real transactions.
# Set to 'phyrhose' and fill in credentials below to go live.
# -----------------------------------------------------------------------------
TRANSACTION_BACKEND="null"

# -----------------------------------------------------------------------------
# QR export storage (idempotent generate-once cache)
# -----------------------------------------------------------------------------
# Generated QR sticker bundles are cached and reused on repeat downloads (saves
# regeneration cost). Choose where they live:
#   - Self-hosted: leave blank (uses the default FILESYSTEM_DISK, i.e. local disk).
#   - A serverless host with a response size limit: set to "s3" so downloads are served
#     via a signed URL (which sidesteps the limit) and can auto-expire via an S3
#     lifecycle rule.
#   - A managed host with an attached bucket: leave blank. FILESYSTEM_DISK already
#     points at the attached bucket ("private"), and naming a disk here that the host
#     did not configure only breaks it.
QR_STORAGE_DISK=
QR_STORAGE_PATH=qr-exports
# Stale bundles older than this are pruned daily by `qr:prune-exports` (S3 users may
# prefer a native bucket lifecycle rule instead).
QR_STORAGE_TTL_DAYS=7
# Lifetime (minutes) of the signed download URL on remote disks.
QR_STORAGE_URL_TTL=15
# Seconds a queue worker may spend on ONE ATTEMPT at a bundle before it is stopped. A render
# stores what it has finished and resumes, so this bounds one sitting, not the whole export.
QR_EXPORT_JOB_TIMEOUT=900
# Stickers rendered between two chances to stop. Smaller repeats less work when an attempt is
# cut off, at the cost of more round trips storing the half-finished archive.
QR_EXPORT_CHUNK_SIZE=250
# Seconds one attempt renders for before storing its progress and handing the message back.
# Leave blank to derive it from the queue connection's retry_after, which is the window an
# attempt has to stay inside. Set 0 to store after every batch.
QR_EXPORT_WORK_BUDGET=
# Minutes an export may keep resuming before it is given up on. There is no limit on how many
# codes an export may hold; this clock is the bound instead.
QR_EXPORT_RESUME_WINDOW=60
# Days an export's record is kept after its bundle has gone. The bundle expires on the TTL
# above; the record is the history of what was printed and the settings a regenerate replays,
# so it is kept for much longer and then deleted so the table stays bounded.
QR_EXPORT_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Claim subdomain (optional)
# -----------------------------------------------------------------------------
# Dedicated host for the claim endpoint, e.g. "claim.onbd.io". When set, claim
# URLs and QR deep-links use https://<domain>/v1/{campaign} (shorter payload =>
# less dense, more scannable QR). Requires the subdomain to resolve to this app
# (DNS + your host's domain config). Leave blank to use /api/claim/v1/{campaign}.
CLAIM_DOMAIN=

# -----------------------------------------------------------------------------
# Phyrhose (transaction backend — required when TRANSACTION_BACKEND=phyrhose)
# Obtain credentials from https://phyrhose.io
# -----------------------------------------------------------------------------
PHYRHOSE_PREPROD_URL=https://testnet.phyrhose.io/
PHYRHOSE_PREPROD_JWT=
PHYRHOSE_PREPROD_ID=
PHYRHOSE_MAINNET_URL=https://api.phyrhose.io/
PHYRHOSE_MAINNET_JWT=
PHYRHOSE_MAINNET_ID=

# -----------------------------------------------------------------------------
# NMKR (NFT minting — optional)
# -----------------------------------------------------------------------------
NMKR_PREPROD_API_URL=https://studio-api.preprod.nmkr.io/v2/
NMKR_PREPROD_API_KEY=
NMKR_MAINNET_API_URL=https://studio-api.nmkr.io/v2/
NMKR_MAINNET_API_KEY=

# -----------------------------------------------------------------------------
# DB-Sync (Cardano chain indexer — optional)
# -----------------------------------------------------------------------------
DBSYNC_PREPROD_HOST=127.0.0.1
DBSYNC_PREPROD_PORT=5432
DBSYNC_PREPROD_DATABASE=cexplorer
DBSYNC_PREPROD_USERNAME=forge
DBSYNC_PREPROD_PASSWORD=

DBSYNC_MAINNET_HOST=127.0.0.1
DBSYNC_MAINNET_PORT=5432
DBSYNC_MAINNET_DATABASE=cexplorer
DBSYNC_MAINNET_USERNAME=forge
DBSYNC_MAINNET_PASSWORD=
