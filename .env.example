APP_NAME="Onboard.Ninja"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=onboard
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
# Local defaults use file and sync so no extra services are required for
# development. On Laravel Cloud (or any Redis-backed host) use redis for cache
# and session, and a managed queue for the queue connection:
#   CACHE_DRIVER=redis
#   SESSION_DRIVER=redis
#   QUEUE_CONNECTION=cloud   (Cloud sets this automatically for a managed queue)
# The withoutOverlapping and RateLimited job middleware rely on an atomic cache
# lock, so the cache store must be redis (or database) once more than one worker
# runs, otherwise the lock is not shared across workers.
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# REDIS_CLIENT: phpredis (the PHP extension, used on Cloud) or predis (a pure-PHP
# fallback, bundled, for environments without the extension).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev uses smtp against mailpit. For production email delivery use Postmark
# (set MAIL_MAILER=postmark and POSTMARK_TOKEN below). Postmark replaces SES, which
# is not available on Laravel Cloud.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Postmark (production email). Server API token from the Postmark dashboard.
# POSTMARK_MESSAGE_STREAM_ID is optional; leave blank to use the default stream.
POSTMARK_TOKEN=
POSTMARK_MESSAGE_STREAM_ID=

# Object storage. Leave blank when self-hosting on the local disk.
#   - Vapor: FILESYSTEM_DISK=s3 plus the credentials below.
#   - Laravel Cloud: attaching a bucket injects FILESYSTEM_DISK and every AWS_* value
#     below automatically, so do NOT set them by hand there. FILESYSTEM_DISK is set to
#     the "disk name" chosen when the bucket was created — this app ships a "private"
#     disk in config/filesystems.php to match. AWS_URL is the one exception: it is shown
#     on the bucket settings page but not injected, so add it as a custom variable if a
#     public bucket needs it.
# An s3-driver disk with no AWS_BUCKET/AWS_DEFAULT_REGION cannot be used at all; the app
# logs the missing keys and falls back to the local disk rather than erroring out.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_VAPOR_ASSET_URL=
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# -----------------------------------------------------------------------------
# Sanctum (stateful SPA auth)
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

# -----------------------------------------------------------------------------
# Admin seeder (DIY single-admin mode)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@onboard.ninja
ADMIN_PASSWORD=password

# -----------------------------------------------------------------------------
# Cardano / Platform
# -----------------------------------------------------------------------------
POO_PUSH_DELAY=

# Upload limits
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_CODES=10000

# Claim API rate limits (requests per minute)
CLAIM_RATE_PER_IP=60
CLAIM_RATE_PER_CAMPAIGN=120

# -----------------------------------------------------------------------------
# Transaction Backend
# Valid values: null (testing), phyrhose (direct), proxy (SaaS relay)
# Default is 'null' for safe local development — no real transactions.
# Set to 'phyrhose' and fill in credentials below to go live.
# -----------------------------------------------------------------------------
TRANSACTION_BACKEND="null"

# -----------------------------------------------------------------------------
# QR export storage (idempotent generate-once cache)
# -----------------------------------------------------------------------------
# Generated QR sticker bundles are cached and reused on repeat downloads (saves
# regeneration cost). Choose where they live:
#   - Self-hosted: leave blank (uses the default FILESYSTEM_DISK, i.e. local disk).
#   - SaaS / Vapor: set to "s3" so downloads are served via a signed URL (avoids the
#     Lambda 6MB response limit) and can auto-expire via an S3 lifecycle rule.
#   - Laravel Cloud: leave blank. FILESYSTEM_DISK already points at the attached bucket
#     ("private"), and naming a disk here that Cloud did not configure only breaks it.
QR_STORAGE_DISK=
QR_STORAGE_PATH=qr-exports
# Stale bundles older than this are pruned daily by `qr:prune-exports` (S3 users may
# prefer a native bucket lifecycle rule instead).
QR_STORAGE_TTL_DAYS=7
# Lifetime (minutes) of the signed download URL on remote disks.
QR_STORAGE_URL_TTL=15

# -----------------------------------------------------------------------------
# Claim subdomain (optional)
# -----------------------------------------------------------------------------
# Dedicated host for the claim endpoint, e.g. "claim.onbd.io". When set, claim
# URLs and QR deep-links use https://<domain>/v1/{campaign} (shorter payload =>
# less dense, more scannable QR). Requires the subdomain to resolve to this app
# (DNS + your host/Vapor domain config). Leave blank to use /api/claim/v1/{campaign}.
CLAIM_DOMAIN=

# -----------------------------------------------------------------------------
# Phyrhose (transaction backend — required when TRANSACTION_BACKEND=phyrhose)
# Obtain credentials from https://phyrhose.io
# -----------------------------------------------------------------------------
PHYRHOSE_PREPROD_URL=https://testnet.phyrhose.io/
PHYRHOSE_PREPROD_JWT=
PHYRHOSE_PREPROD_ID=
PHYRHOSE_MAINNET_URL=https://api.phyrhose.io/
PHYRHOSE_MAINNET_JWT=
PHYRHOSE_MAINNET_ID=

# -----------------------------------------------------------------------------
# NMKR (NFT minting — optional)
# -----------------------------------------------------------------------------
NMKR_PREPROD_API_URL=https://studio-api.preprod.nmkr.io/v2/
NMKR_PREPROD_API_KEY=
NMKR_MAINNET_API_URL=https://studio-api.nmkr.io/v2/
NMKR_MAINNET_API_KEY=

# -----------------------------------------------------------------------------
# DB-Sync (Cardano chain indexer — optional)
# -----------------------------------------------------------------------------
DBSYNC_PREPROD_HOST=127.0.0.1
DBSYNC_PREPROD_PORT=5432
DBSYNC_PREPROD_DATABASE=cexplorer
DBSYNC_PREPROD_USERNAME=forge
DBSYNC_PREPROD_PASSWORD=

DBSYNC_MAINNET_HOST=127.0.0.1
DBSYNC_MAINNET_PORT=5432
DBSYNC_MAINNET_DATABASE=cexplorer
DBSYNC_MAINNET_USERNAME=forge
DBSYNC_MAINNET_PASSWORD=
