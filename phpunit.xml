<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/Auth/RegistrationTest.php</exclude>
            <exclude>tests/Feature/Auth/PasswordResetTest.php</exclude>
            <exclude>tests/Feature/Auth/EmailVerificationTest.php</exclude>
            <exclude>tests/Feature/Auth/PasswordConfirmationTest.php</exclude>
            <exclude>tests/Feature/Auth/PasswordUpdateTest.php</exclude>
            <exclude>tests/Feature/ProfileTest.php</exclude>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>saas-only</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>app/Http/Controllers/Auth</directory>
            <file>app/Providers/BroadcastServiceProvider.php</file>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:lI6gNEZbi2sItf0uOYVt5Ybi5L2N711OmNIkQNcIZtA="/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="ALLOWED_NETWORKS" value="preprod,preview,mainnet"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!-- Pinned so the suite does not inherit a developer's transaction backend. With
             a real one bound, anything that reads a protocol parameter reaches for a
             third-party query layer during a unit test. -->
        <env name="TRANSACTION_BACKEND" value="null"/>
        <!-- Pinned for the same reason: the minimum-UTxO figures asserted in tests are
             mainnet's coefficient, not whatever a machine happens to have configured. -->
        <env name="COINS_PER_UTXO_BYTE" value="4310"/>
        <env name="MIN_UTXO_HEADROOM_LOVELACE" value="1000000"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
